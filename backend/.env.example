# Copy to backend/.env (or put these in the repo-root .env, which is read first).
# Never put real keys in this file - it is committed to git.
PORT=4000
GEMINI_API_KEY=your_gemini_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_secret_key
REDIS_URL=redis://localhost:6379
USE_MOCK_AI=false
GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
GEMINI_ANSWER_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
# Demo video (these are the defaults; only set them to use a different video)
# DEMO_YOUTUBE_URL=https://www.youtube.com/watch?v=eeMJg4uI7o0
# DEMO_LECTURE_TITLE=Independence, Basis, and Dimension
# DEMO_VIDEO_DURATION_SEC=799   # needed for videos over 10 min (transcribed in 10-min windows)
